# Public ports on the VPS (nginx)
HTTP_PORT=80
HTTPS_PORT=443

# Domain TLS (scripts/setup-ssl.sh)
# DOMAIN=golf.gilbertsibuea.id
# CERTBOT_EMAIL=admin@gilbertsibuea.id

# CORS for Go backend (use * behind same-origin nginx, or list your domain)
# CORS_ORIGINS=https://golf.gilbertsibuea.id,http://localhost
CORS_ORIGINS=*
